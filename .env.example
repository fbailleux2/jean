# Jean environment variables
# Copy to .env and fill in values before running

# ── jean-aggregator ──────────────────────────────────────────────────────────
# Storage backend: memory (default) or postgres
JEAN_STORE=memory

# PostgreSQL DSN (required when JEAN_STORE=postgres)
JEAN_PG_DSN=postgresql://jean:jean@localhost/jean

# ── jean-agent ───────────────────────────────────────────────────────────────
# URL of the jean-aggregator ingest endpoint
JEAN_AGGREGATOR_URL=http://localhost:8100

# Business process context for captured events
JEAN_PROCESS_CONTEXT=invoice-exception

# Pseudonymous workstation identifier (auto-generated UUID if not set)
# JEAN_WORKSTATION_ID=ws-001

# Path to the local SQLite event buffer
JEAN_BUFFER_PATH=jean-agent.db

# ── KFabric ──────────────────────────────────────────────────────────────────
# Optional: KFabric ingest URL (uses MockKFabricAdapter if unset)
# JEAN_KFABRIC_URL=http://kfabric:8300

# ── Authentication ───────────────────────────────────────────────────────────
# API key for X-API-Key header (protects POST /ingest, approve, reject)
# Leave unset to disable auth (dev/test only — always set in production)
# JEAN_API_KEY=change-me-in-production

# ── jean-validator ───────────────────────────────────────────────────────────
# URL of jean-validator for auto-observation dispatch from aggregator
# Leave unset to disable auto-dispatch
# JEAN_VALIDATOR_URL=http://localhost:8200

# Path to SQLite file for validator observation persistence
# Leave unset to use in-memory store (observations lost on restart)
# JEAN_OBS_STORE_PATH=/data/observations.db

# Optional: FlowFabric webhook URL for post-approval notifications
# Leave empty to disable the bridge
# JEAN_FLOWFABRIC_WEBHOOK=http://flowfabric:8000/api/jean/observations

# ── Logging ──────────────────────────────────────────────────────────────────
JEAN_LOG_LEVEL=info
